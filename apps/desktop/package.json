{
  "name": "calibar-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc && tsc -p e2e",
    "lint": "biome check .",
    "test": "bun test",
    "tauri": "tauri",
    "e2e:build": "tauri build --debug --no-bundle --features e2e",
    "e2e": "wdio run e2e/wdio.conf.ts"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "@wdio/tauri-service": "^1.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "webdriverio": "^10.0.2"
  },
  "packageManager": "bun@1.4.2"
}
